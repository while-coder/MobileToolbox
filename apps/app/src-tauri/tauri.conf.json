{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MobileToolbox",
  "version": "0.1.0",
  "identifier": "com.whilecode.mobiletoolbox",
  "build": {
    "beforeDevCommand": "pnpm --filter @mobiletoolbox/protocol build && pnpm --filter @mobiletoolbox/app dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "pnpm --filter @mobiletoolbox/protocol build && pnpm --filter @mobiletoolbox/app build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MobileToolbox",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "移动应用与设备工具箱",
    "longDescription": "MobileToolbox 可以解析 APK 清单与权限、解包资源、生成 JAR、反编译 Java 源码，并通过 adb 安装到真机或模拟器。全部处理都在本机完成。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/tools/**/*"
    ]
  }
}
